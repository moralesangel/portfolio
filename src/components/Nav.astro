---
import { profile } from '../data/profile';

const links = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#research', label: 'Research' },
  { href: '#stack', label: 'Stack' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 border-b border-line/60 bg-ink/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4">
    <a href="#top" class="font-semibold tracking-tight text-neutral-100 hover:text-accent">
      ángel<span class="text-accent">.</span>
    </a>

    <ul class="hidden items-center gap-6 text-sm md:flex">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="text-neutral-400 transition-colors hover:text-accent">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={profile.links.github}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full border border-line px-4 py-1.5 text-sm text-neutral-300 transition-colors hover:border-accent hover:text-accent"
    >
      GitHub
    </a>
  </nav>
</header>
