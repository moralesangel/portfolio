---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

/** GitHub-ish language dot colors. */
const languageColors: Record<string, string> = {
  Python: '#3572A5',
  'Jupyter Notebook': '#DA5B0B',
  JavaScript: '#F1E05A',
  TypeScript: '#3178C6',
  MATLAB: '#E16737',
  'C++': '#F34B7D',
  HTML: '#E34C26',
};

const dot = project.language ? (languageColors[project.language] ?? '#8B949E') : null;
const topics = project.topics.slice(0, 4);
---

<a
  href={project.url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex h-full flex-col rounded-xl border border-line bg-raised/50 p-6 transition-all hover:-translate-y-1 hover:border-accent/60 hover:bg-raised"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-semibold text-neutral-100 transition-colors group-hover:text-accent">
      {project.title}
    </h3>
    <svg
      class="size-4 shrink-0 text-neutral-600 transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M7 17 17 7M7 7h10v10" />
    </svg>
  </div>

  {
    project.description && (
      <p class="mt-3 line-clamp-4 flex-1 text-sm leading-relaxed text-neutral-400">
        {project.description}
      </p>
    )
  }

  {
    topics.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {topics.map((topic) => (
          <li class="rounded border border-line/70 px-2 py-0.5 font-mono text-[11px] text-neutral-500">
            {topic}
          </li>
        ))}
      </ul>
    )
  }

  {
    project.language && (
      <p class="mt-4 flex items-center gap-2 text-xs text-neutral-500">
        <span class="inline-block size-2.5 rounded-full" style={`background:${dot}`} />
        {project.language}
      </p>
    )
  }
</a>
