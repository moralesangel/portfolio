---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

/** GitHub-ish language dot colors. */
const languageColors: Record<string, string> = {
  Python: '#3572A5',
  'Jupyter Notebook': '#DA5B0B',
  JavaScript: '#F1E05A',
  TypeScript: '#3178C6',
  MATLAB: '#E16737',
  'C++': '#F34B7D',
  HTML: '#E34C26',
  Astro: '#BC52EE',
};

const dot = project.language ? (languageColors[project.language] ?? '#8B949E') : null;
const topics = project.topics.slice(0, 4);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = project.image ? `${base}/projects/${project.image}.webp` : null;
const img2x = project.image ? `${base}/projects/${project.image}@2x.webp` : null;
---

{/* The card is a container rather than one big link, so the demo link can sit inside it. */}
<article
  class="group relative flex h-full flex-col overflow-hidden rounded-xl border border-line bg-raised/50 transition-all hover:-translate-y-1 hover:border-accent/60 hover:bg-raised"
>
  {
    img ? (
      <div class="relative aspect-[8/5] overflow-hidden border-b border-line bg-ink">
        <img
          src={img}
          srcset={`${img} 800w, ${img2x} 1600w`}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          alt={project.imageAlt}
          width="800"
          height="500"
          loading="lazy"
          decoding="async"
          class="size-full object-cover object-top opacity-90 transition-all duration-500 group-hover:scale-[1.04] group-hover:opacity-100"
        />
      </div>
    ) : (
      /* No screenshot: a quiet panel so every card in a row shares a baseline. */
      <div
        class="relative flex aspect-[8/5] items-center justify-center overflow-hidden border-b border-line bg-ink"
        aria-hidden="true"
      >
        <div
          class="absolute inset-0 opacity-[0.07]"
          style="background-image:radial-gradient(circle at 1px 1px,#fff 1px,transparent 0);background-size:14px 14px"
        />
        <span class="relative font-mono text-xs tracking-[0.2em] text-neutral-600 uppercase">
          {project.language ?? 'Code'}
        </span>
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-6">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-semibold text-neutral-100 transition-colors group-hover:text-accent">
      {/* Stretched link: makes the whole card clickable without nesting anchors. */}
      <a href={project.url} target="_blank" rel="noopener noreferrer" class="after:absolute after:inset-0">
        {project.title}
      </a>
    </h3>
    <svg
      class="size-4 shrink-0 text-neutral-600 transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M7 17 17 7M7 7h10v10" />
    </svg>
  </div>

  {
    project.metric && (
      <p class="mt-2 font-mono text-xs text-accent">{project.metric}</p>
    )
  }

  {
    project.description && (
      <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-neutral-400">
        {project.description}
      </p>
    )
  }

  {
    topics.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {topics.map((topic) => (
          <li class="rounded border border-line/70 px-2 py-0.5 font-mono text-[11px] text-neutral-500">
            {topic}
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-auto flex items-center justify-between gap-3 pt-4">
    {
      project.language ? (
        <p class="flex items-center gap-2 text-xs text-neutral-500">
          <span class="inline-block size-2.5 rounded-full" style={`background:${dot}`} />
          {project.language}
        </p>
      ) : (
        <span />
      )
    }

    {
      project.demo && (
        /* Raised above the stretched link so it stays independently clickable. */
        <a
          href={project.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="relative z-10 inline-flex items-center gap-1.5 rounded-md bg-accent/15 px-2.5 py-1 text-xs font-medium text-accent transition-colors hover:bg-accent hover:text-ink"
        >
          <svg
            class="size-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m5 3 14 9-14 9V3z" />
          </svg>
          Live demo
        </a>
      )
    }
  </div>
  </div>
</article>
