---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
}

const { id, eyebrow, title, lead } = Astro.props;
---

<section id={id} class="mx-auto max-w-5xl scroll-mt-24 px-6 py-20 md:py-24">
  <div class="reveal">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">{eyebrow}</p>
    <h2 class="mt-3 text-3xl font-semibold tracking-tight text-neutral-100 md:text-4xl">{title}</h2>
    {lead && <p class="mt-4 max-w-2xl text-neutral-400">{lead}</p>}
  </div>

  <div class="mt-10">
    <slot />
  </div>
</section>
