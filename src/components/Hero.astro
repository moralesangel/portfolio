---
import { profile, interests } from '../data/profile';
---

<section id="top" class="mx-auto max-w-5xl px-6 pb-16 pt-20 md:pb-24 md:pt-28">
  <div class="reveal flex flex-col gap-10 md:flex-row md:items-center">
    <div class="flex-1">
      <p class="font-mono text-sm text-accent">Hi, my name is</p>

      <h1 class="mt-4 text-4xl font-bold tracking-tight text-neutral-50 sm:text-5xl md:text-6xl">
        {profile.name}
      </h1>

      <p class="mt-3 max-w-xl text-xl font-medium text-balance text-neutral-300 md:text-2xl">
        {profile.tagline}
        <span class="text-neutral-500"> · </span>
        <span class="text-neutral-400">{profile.subtitle}</span>
      </p>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-400">
        {profile.bio}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#projects"
          class="rounded-lg bg-accent px-5 py-2.5 font-medium text-ink transition-colors hover:bg-accent-soft"
        >
          View projects
        </a>
        <a
          href="#contact"
          class="rounded-lg border border-line px-5 py-2.5 font-medium text-neutral-200 transition-colors hover:border-accent hover:text-accent"
        >
          Get in touch
        </a>
      </div>

      <p class="mt-8 flex items-center gap-2 text-sm text-neutral-500">
        <span class="inline-block size-2 rounded-full bg-accent"></span>
        {profile.location} · open to relocation and remote
      </p>
    </div>

    <div class="shrink-0 md:w-64">
      <div class="relative mx-auto w-44 md:w-full">
        <div class="absolute -inset-3 rounded-2xl bg-accent/20 blur-2xl"></div>
        <img
          src={profile.avatar}
          alt={profile.name}
          width="256"
          height="256"
          loading="eager"
          class="relative aspect-square w-full rounded-2xl border border-line object-cover"
        />
      </div>
    </div>
  </div>

  <ul class="reveal mt-14 flex flex-wrap gap-2">
    {
      interests.map((interest) => (
        <li class="rounded-full border border-line bg-raised/60 px-3 py-1 text-sm text-neutral-400">
          {interest}
        </li>
      ))
    }
  </ul>
</section>
